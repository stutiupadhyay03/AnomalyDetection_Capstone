# Copy this file to .env and fill in values for your environment.
# All variables are optional — the defaults work for the standard repo layout.

# ── Model paths ─────────────────────────────────────────────────────────────
# Directory containing all three .pt files (overrides individual paths below)
# MODEL_DIR=notebooks

# Individual overrides (take precedence over MODEL_DIR)
# CSRNET_MODEL_PATH=notebooks/csrnet_shanghai.pt
# ANOMALY_MODEL_PATH=notebooks/final_op_avenue_model.pt
# YOLO_MODEL_PATH=notebooks/yolov8m.pt

# ── Inference settings ───────────────────────────────────────────────────────
# Maximum number of video frames to process per upload
# MAX_VIDEO_FRAMES=150

# Minimum softmax confidence to display a label; below this shows "uncertain"
# CONFIDENCE_THRESHOLD=0.50

# CSRNet crowd count below which YOLOv8 fallback is triggered
# CSRNET_FALLBACK_THRESHOLD=1.0

# Maximum allowed upload size in megabytes
# MAX_UPLOAD_SIZE_MB=200
